{
  "expo": {
    "name": "hotel-app",
    "slug": "hotel-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hotel-logo.png",
    "scheme": "hotelapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.betsy-emb.hotelapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.betsy_emb.hotelapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/hotel-logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/hotel-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "backendUrl": "https://hotel-genesis-backend.onrender.com",
      "EXPO_PUBLIC_COTIZAVE_KEY": "ctz_live_01UWSgfeJlK61Cc9Z4VfKPIvVstRG1bGk0aWy7",
      "EXPO_PUBLIC_COTIZAVE_API_URL": "https://api.cotizave.com/v1/fx/rates",
      "EXPO_PUBLIC_BASE_URL": "https://hotel-genesis-backend.onrender.com",
      "eas": {
        "projectId": "f64248bc-5451-4b92-94db-afc4b88ad660"
      }
    }
  }
}